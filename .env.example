# Runtime
LSG_HOST=127.0.0.1
LSG_PORT=7347
LSG_DB_PATH=./data/lsg.sqlite
LSG_WORKSPACE_ROOT=.
LSG_LOG_LEVEL=info
LSG_MAX_BODY_BYTES=2097152
LSG_RATE_LIMIT_PER_MINUTE=240

# Security. Strongly recommended for any non-loopback bind.
LSG_API_TOKEN=replace-with-a-long-random-token
LSG_ALLOWED_ORIGINS=http://127.0.0.1:7347,http://localhost:7347
LSG_ALLOWED_HOSTS=127.0.0.1:7347,localhost:7347
LSG_ALLOW_INSECURE=false

# Optional OpenAI-compatible upstream proxy.
# Virtual LSG model aliases are mapped before forwarding.
LSG_UPSTREAM_BASE_URL=
LSG_UPSTREAM_API_KEY=
LSG_MODEL_MAP_JSON={"lsg-auto":"gpt-5.6","lsg-solve":"gpt-5.6","lsg-implement":"gpt-5.6","lsg-audit":"gpt-5.6","lsg-fast":"gpt-5.6"}
